meta {
  name: Create token
  type: http
  seq: 2
}

post {
  url: http://{{auth-service.host}}:{{auth-service.port}}/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: my-client-id
  password: my-client-secret
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: read,write
}

settings {
  encodeUrl: true
}
